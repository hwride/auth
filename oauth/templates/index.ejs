<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>OAuth Client</title>
    <style>
      #authorize-controls {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        align-items: flex-start;
      }

      #authorize-controls > fieldset {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        width: fit-content;
      }

      #authorize-controls label {
        display: flex;
        align-items: center;
        gap: 0.35rem;
      }

      .scopes-fieldset {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 0.75rem;
        width: fit-content;
      }

      .scopes-fieldset label {
        gap: 0.25rem;
      }

      .scopes-fieldset .additional-scopes-row {
        flex-basis: 100%;
      }

      table {
        border-collapse: collapse;
      }

      th,
      td {
        padding: 0.25rem 0.5rem 0.25rem 0;
        text-align: left;
        vertical-align: top;
      }
    </style>
  </head>
  <body>
    <h1>OAuth Client</h1>
    <h2>Configuration</h2>

    <table>
      <tbody>
        <tr>
          <th>Client ID</th>
          <td><%= clientId || "No client ID configured." %></td>
        </tr>
        <tr>
          <th>Authorization server URL</th>
          <td>
            <% if (authServerBaseUrl) { %>
            <a href="<%= authServerBaseUrl %>"><%= authServerBaseUrl %></a>
            <% } else { %>
            No authorization server base URL configured.
            <% } %>
          </td>
        </tr>
        <tr>
          <th>Discovery URL</th>
          <td>
            <% if (discoveryUrlUsed) { %>
            <a href="<%= discoveryUrlUsed %>"><%= discoveryUrlUsed %></a>
            <% } else { %>
            No discovery URL used (fallback endpoints configured).
            <% } %>
          </td>
        </tr>
        <tr>
          <th>Authorization endpoint URL</th>
          <td>
            <a href="<%= authorizationEndpointUsed %>"
              ><%= authorizationEndpointUsed %></a
            >
          </td>
        </tr>
        <tr>
          <th>Token endpoint URL</th>
          <td>
            <a href="<%= tokenEndpointUsed %>"><%= tokenEndpointUsed %></a>
          </td>
        </tr>
        <tr>
          <th>JWKS URL</th>
          <td><a href="<%= jwksUrlUsed %>"><%= jwksUrlUsed %></a></td>
        </tr>
      </tbody>
    </table>

    <h2>Authorization request</h2>
    <div id="authorize-controls">
      <fieldset id="oauth-fieldset">
        <legend>OAuth 2.0</legend>
        <fieldset id="oauth-scopes-fieldset" class="scopes-fieldset">
          <legend>Scopes</legend>
          <label>
            <input
              type="checkbox"
              value="offline_access"
              class="scope-checkbox"
            />
            offline_access
          </label>
          <label class="additional-scopes-row">
            <input type="checkbox" id="additional-scopes-checkbox" />
            Use additional scopes?
            <input
              type="text"
              id="additional-scopes-input"
              placeholder="resource.read resource.write"
            />
          </label>
        </fieldset>
        <label>
          <input type="checkbox" id="state-checkbox" checked />
          Use state?
        </label>
        <label>
          <input type="checkbox" id="pkce-checkbox" checked />
          Use Proof Key for Code Exchange (PKCE)?
        </label>
        <label>
          <input type="checkbox" id="audience-checkbox" />
          Use audience?
          <input
            type="text"
            id="audience-input"
            placeholder="https://api.example.com/"
          />
        </label>
      </fieldset>
      <fieldset id="oidc-fieldset">
        <legend>OpenID Connect 1.0</legend>
        <fieldset id="oidc-scopes-fieldset" class="scopes-fieldset">
          <legend>Scopes</legend>
          <label>
            <input
              type="checkbox"
              value="openid"
              id="openid-scope-checkbox"
              class="scope-checkbox"
              checked
            />
            openid
          </label>
          <label>
            <input type="checkbox" value="email" class="scope-checkbox" />
            email
          </label>
          <label>
            <input type="checkbox" value="profile" class="scope-checkbox" />
            profile
          </label>
          <label>
            <input type="checkbox" value="address" class="scope-checkbox" />
            address
          </label>
          <label>
            <input type="checkbox" value="phone" class="scope-checkbox" />
            phone
          </label>
        </fieldset>
        <label>
          <input type="checkbox" id="nonce-checkbox" checked />
          Use nonce?
        </label>
        <label>
          <input type="checkbox" id="max-age-checkbox" />
          Use max_age?
          <input type="number" id="max-age-input" value="0" min="0" step="1" />
        </label>
        <label>
          <input type="checkbox" id="prompt-checkbox" />
          Use prompt?
          <select id="prompt-select">
            <option value="none">none</option>
            <option value="login">login</option>
            <option value="consent">consent</option>
            <option value="select_account">select_account</option>
          </select>
        </label>
        <label>
          <input type="checkbox" id="display-checkbox" />
          Use display?
          <select id="display-select">
            <option value="page">page</option>
            <option value="popup">popup</option>
            <option value="touch">touch</option>
            <option value="wap">wap</option>
          </select>
        </label>
        <label>
          <input type="checkbox" id="ui-locales-checkbox" />
          Use ui_locales?
          <select id="ui-locales-select">
            <option value="en-GB">en-GB</option>
            <option value="fr-FR">fr-FR</option>
          </select>
        </label>
        <label>
          <input type="checkbox" id="login-hint-checkbox" />
          Use login_hint?
          <input
            type="text"
            id="login-hint-input"
            placeholder="user@example.com"
          />
        </label>
      </fieldset>
      <a id="authorize-link" href="/authorize">Authorize</a>
    </div>
    <script>
      const oauth = {
        stateCheckbox: document.getElementById("state-checkbox"),
        pkceCheckbox: document.getElementById("pkce-checkbox"),
        audienceCheckbox: document.getElementById("audience-checkbox"),
        audienceInput: document.getElementById("audience-input"),
        additionalScopesCheckbox: document.getElementById(
          "additional-scopes-checkbox",
        ),
        additionalScopesInput: document.getElementById(
          "additional-scopes-input",
        ),
        scopeCheckboxes: Array.from(
          document.querySelectorAll("#oauth-scopes-fieldset .scope-checkbox"),
        ),
      };

      const oidc = {
        fieldset: document.getElementById("oidc-fieldset"),
        openidScopeCheckbox: document.getElementById("openid-scope-checkbox"),
        nonceCheckbox: document.getElementById("nonce-checkbox"),
        maxAgeCheckbox: document.getElementById("max-age-checkbox"),
        maxAgeInput: document.getElementById("max-age-input"),
        promptCheckbox: document.getElementById("prompt-checkbox"),
        promptSelect: document.getElementById("prompt-select"),
        displayCheckbox: document.getElementById("display-checkbox"),
        displaySelect: document.getElementById("display-select"),
        uiLocalesCheckbox: document.getElementById("ui-locales-checkbox"),
        uiLocalesSelect: document.getElementById("ui-locales-select"),
        loginHintCheckbox: document.getElementById("login-hint-checkbox"),
        loginHintInput: document.getElementById("login-hint-input"),
        scopeCheckboxes: Array.from(
          document.querySelectorAll("#oidc-scopes-fieldset .scope-checkbox"),
        ),
      };

      const authorizeLink = document.getElementById("authorize-link");

      function syncOidcControls() {
        const oidcInputs = oidc.fieldset.querySelectorAll(
          "input, select, textarea, button",
        );
        oidcInputs.forEach((el) => {
          if (el === oidc.openidScopeCheckbox) {
            return;
          }
          el.disabled = !oidc.openidScopeCheckbox.checked;
        });
      }

      function updateAuthorizeLink() {
        const queryParams = new URLSearchParams();

        if (oauth.stateCheckbox.checked) {
          queryParams.set("use_state", "true");
        }
        if (oauth.pkceCheckbox.checked) {
          queryParams.set("use_pkce", "true");
        }
        if (oauth.audienceCheckbox.checked) {
          const audience = oauth.audienceInput.value.trim();
          if (audience) {
            queryParams.set("audience", audience);
          }
        }

        const oidcEnabled = oidc.openidScopeCheckbox.checked;
        if (oidcEnabled) {
          if (oidc.nonceCheckbox.checked) {
            queryParams.set("use_nonce", "true");
          }
          if (oidc.maxAgeCheckbox.checked) {
            queryParams.set("max_age", oidc.maxAgeInput.value || "0");
          }
          if (oidc.promptCheckbox.checked) {
            queryParams.set("prompt", oidc.promptSelect.value);
          }
          if (oidc.displayCheckbox.checked) {
            queryParams.set("display", oidc.displaySelect.value);
          }
          if (oidc.uiLocalesCheckbox.checked) {
            queryParams.set("ui_locales", oidc.uiLocalesSelect.value);
          }
          if (oidc.loginHintCheckbox.checked) {
            const loginHint = oidc.loginHintInput.value.trim();
            if (loginHint) {
              queryParams.set("login_hint", loginHint);
            }
          }
        }

        // Scopes
        const scopeCheckboxes = oidcEnabled
          ? [...oauth.scopeCheckboxes, ...oidc.scopeCheckboxes]
          : [...oauth.scopeCheckboxes];
        const selectedScopes = scopeCheckboxes
          .filter((el) => el.checked)
          .map((el) => el.value);
        const additionalScopes = oauth.additionalScopesCheckbox.checked
          ? oauth.additionalScopesInput.value
              .split(/\s+/)
              .map((scope) => scope.trim())
              .filter(Boolean)
          : [];
        const scope = [
          ...new Set([...selectedScopes, ...additionalScopes]),
        ].join(" ");
        if (scope) {
          queryParams.set("scope", scope);
        }

        let href = "/authorize";
        if (queryParams.toString()) {
          href += "?" + queryParams.toString();
        }
        authorizeLink.setAttribute("href", href);
      }

      function addListeners(elements, eventName, listener) {
        elements.forEach((el) => el.addEventListener(eventName, listener));
      }

      function bindOAuthListeners() {
        addListeners(
          [
            ...oauth.scopeCheckboxes,
            oauth.stateCheckbox,
            oauth.pkceCheckbox,
            oauth.audienceCheckbox,
            oauth.additionalScopesCheckbox,
          ],
          "change",
          updateAuthorizeLink,
        );
        addListeners(
          [oauth.additionalScopesInput, oauth.audienceInput],
          "input",
          updateAuthorizeLink,
        );
      }

      function bindOidcListeners() {
        const oidcScopeCheckboxes = oidc.scopeCheckboxes.filter(
          (el) => el !== oidc.openidScopeCheckbox,
        );
        addListeners([oidc.openidScopeCheckbox], "change", syncOidcControls);
        addListeners(
          [
            oidc.openidScopeCheckbox,
            ...oidcScopeCheckboxes,
            oidc.nonceCheckbox,
            oidc.maxAgeCheckbox,
            oidc.promptCheckbox,
            oidc.promptSelect,
            oidc.displayCheckbox,
            oidc.displaySelect,
            oidc.uiLocalesCheckbox,
            oidc.uiLocalesSelect,
            oidc.loginHintCheckbox,
          ],
          "change",
          updateAuthorizeLink,
        );
        addListeners(
          [oidc.maxAgeInput, oidc.loginHintInput],
          "input",
          updateAuthorizeLink,
        );
      }

      bindOAuthListeners();
      bindOidcListeners();

      syncOidcControls();
      updateAuthorizeLink();
    </script>
  </body>
</html>

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>OAuth Client</title>
    <style>
      #authorize-controls {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        align-items: flex-start;
      }

      #authorize-controls > fieldset {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        width: fit-content;
      }

      #authorize-controls label {
        display: flex;
        align-items: center;
        gap: 0.35rem;
      }

      #resource-request-form {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        align-items: flex-start;
      }

      #resource-request-url-input {
        width: min(100%, 36rem);
      }

      #resource-request-form label {
        display: flex;
        align-items: center;
        gap: 0.35rem;
      }

      #resource-request-result:empty {
        display: none;
      }

      .resource-request-success-title {
        color: #0a7f28;
      }

      .resource-request-error-title {
        color: #b00020;
      }

      .resource-request-used-url {
        overflow-wrap: anywhere;
      }

      .scopes-fieldset {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 0.75rem;
        width: fit-content;
      }

      .scopes-fieldset label {
        gap: 0.25rem;
      }

      .scopes-fieldset .additional-scopes-row {
        flex-basis: 100%;
      }

      table {
        border-collapse: collapse;
      }

      th,
      td {
        padding: 0.25rem 0.5rem 0.25rem 0;
        text-align: left;
        vertical-align: top;
      }

      .token-value {
        display: block;
        max-width: 70ch;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
      }

      pre {
        max-width: 100%;
        overflow-x: auto;
        box-sizing: border-box;
      }
    </style>
  </head>
  <body>
    <h1>OAuth Client</h1>
    <h2>Configuration</h2>

    <table>
      <tbody>
        <tr>
          <th>Client ID</th>
          <td><%= clientId || "No client ID configured." %></td>
        </tr>
        <tr>
          <th>Authorization server URL</th>
          <td>
            <% if (authServerBaseUrl) { %>
            <a href="<%= authServerBaseUrl %>"><%= authServerBaseUrl %></a>
            <% } else { %>
            No authorization server base URL configured.
            <% } %>
          </td>
        </tr>
        <tr>
          <th>Discovery URL</th>
          <td>
            <% if (discoveryUrlUsed) { %>
            <a href="<%= discoveryUrlUsed %>"><%= discoveryUrlUsed %></a>
            <% } else { %>
            No discovery URL used (fallback endpoints configured).
            <% } %>
          </td>
        </tr>
        <tr>
          <th>Authorization endpoint URL</th>
          <td>
            <a href="<%= authorizationEndpointUsed %>"
              ><%= authorizationEndpointUsed %></a
            >
          </td>
        </tr>
        <tr>
          <th>Token endpoint URL</th>
          <td>
            <a href="<%= tokenEndpointUsed %>"><%= tokenEndpointUsed %></a>
          </td>
        </tr>
        <tr>
          <th>JWKS URL</th>
          <td><a href="<%= jwksUrlUsed %>"><%= jwksUrlUsed %></a></td>
        </tr>
      </tbody>
    </table>

    <h2>Authorization request</h2>
    <div id="authorize-controls">
      <fieldset id="oauth-fieldset">
        <legend>OAuth 2.0</legend>
        <fieldset id="oauth-scopes-fieldset" class="scopes-fieldset">
          <legend>Scopes</legend>
          <label>
            <input
              type="checkbox"
              value="offline_access"
              class="scope-checkbox"
            />
            offline_access
          </label>
          <label class="additional-scopes-row">
            <input type="checkbox" id="additional-scopes-checkbox" />
            Use additional scopes?
            <input
              type="text"
              id="additional-scopes-input"
              placeholder="resource.read resource.write"
            />
          </label>
        </fieldset>
        <label>
          <input type="checkbox" id="state-checkbox" checked />
          Use state?
        </label>
        <label>
          <input type="checkbox" id="pkce-checkbox" checked />
          Use Proof Key for Code Exchange (PKCE)?
        </label>
        <label>
          <input
            type="checkbox"
            id="resource-checkbox"
            <%= useDefaultResource ? "checked" : "" %>
          />
          Use resource?
          <input
            type="text"
            id="resource-input"
            placeholder="https://api.example.com/"
            value="<%= defaultResource %>"
          />
        </label>
        <label>
          <input
            type="checkbox"
            id="audience-checkbox"
            <%= useDefaultAudience ? "checked" : "" %>
          />
          Use audience?
          <input
            type="text"
            id="audience-input"
            placeholder="https://api.example.com/"
            value="<%= defaultAudience %>"
          />
        </label>
      </fieldset>
      <fieldset id="oidc-fieldset">
        <legend>OpenID Connect 1.0</legend>
        <fieldset id="oidc-scopes-fieldset" class="scopes-fieldset">
          <legend>Scopes</legend>
          <label>
            <input
              type="checkbox"
              value="openid"
              id="openid-scope-checkbox"
              class="scope-checkbox"
              checked
            />
            openid
          </label>
          <label>
            <input type="checkbox" value="email" class="scope-checkbox" />
            email
          </label>
          <label>
            <input type="checkbox" value="profile" class="scope-checkbox" />
            profile
          </label>
          <label>
            <input type="checkbox" value="address" class="scope-checkbox" />
            address
          </label>
          <label>
            <input type="checkbox" value="phone" class="scope-checkbox" />
            phone
          </label>
        </fieldset>
        <label>
          <input type="checkbox" id="nonce-checkbox" checked />
          Use nonce?
        </label>
        <label>
          <input type="checkbox" id="max-age-checkbox" />
          Use max_age?
          <input type="number" id="max-age-input" value="0" min="0" step="1" />
        </label>
        <label>
          <input type="checkbox" id="prompt-checkbox" />
          Use prompt?
          <select id="prompt-select">
            <option value="none">none</option>
            <option value="login">login</option>
            <option value="consent">consent</option>
            <option value="select_account">select_account</option>
          </select>
        </label>
        <label>
          <input type="checkbox" id="display-checkbox" />
          Use display?
          <select id="display-select">
            <option value="page">page</option>
            <option value="popup">popup</option>
            <option value="touch">touch</option>
            <option value="wap">wap</option>
          </select>
        </label>
        <label>
          <input type="checkbox" id="ui-locales-checkbox" />
          Use ui_locales?
          <select id="ui-locales-select">
            <option value="en-GB">en-GB</option>
            <option value="fr-FR">fr-FR</option>
          </select>
        </label>
        <label>
          <input type="checkbox" id="login-hint-checkbox" />
          Use login_hint?
          <input
            type="text"
            id="login-hint-input"
            placeholder="user@example.com"
          />
        </label>
      </fieldset>
      <a id="authorize-link" href="/authorize">Authorize</a>
    </div>

    <h2>Resource server request</h2>
    <form id="resource-request-form" method="post" action="/resource-request">
      <label for="resource-request-url-input">URL</label>
      <input
        type="text"
        id="resource-request-url-input"
        name="resource_url"
        value="http://localhost:5000/orders"
      />
      <label>
        <input
          type="checkbox"
          id="use-invalid-access-token-checkbox"
          name="use_invalid_access_token"
          value="true"
        />
        Use invalid access token
      </label>
      <button type="submit" id="resource-request-submit-button">
        Send request
      </button>
    </form>

    <div id="resource-request-result"></div>

    <h2>Stored token state (in-memory)</h2>
    <table>
      <tbody>
        <tr>
          <th>Access token</th>
          <td>
            <% if (accessToken) { %>
            <code class="token-value"><%= accessToken %></code>
            <% } else { %>
            Not stored.
            <% } %>
          </td>
        </tr>
        <tr>
          <th>ID token</th>
          <td>
            <% if (idToken) { %>
            <code class="token-value"><%= idToken %></code>
            <% } else { %>
            Not stored.
            <% } %>
          </td>
        </tr>
        <tr>
          <th>Refresh token</th>
          <td>
            <% if (refreshToken) { %>
            <code class="token-value"><%= refreshToken %></code>
            <% } else { %>
            Not stored.
            <% } %>
          </td>
        </tr>
      </tbody>
    </table>
    <form method="post" action="/refresh">
      <button type="submit" <%= hasRefreshToken ? "" : "disabled" %>>
        Refresh tokens
      </button>
    </form>

    <script>
      const oauth = {
        stateCheckbox: document.getElementById("state-checkbox"),
        pkceCheckbox: document.getElementById("pkce-checkbox"),
        resourceCheckbox: document.getElementById("resource-checkbox"),
        resourceInput: document.getElementById("resource-input"),
        audienceCheckbox: document.getElementById("audience-checkbox"),
        audienceInput: document.getElementById("audience-input"),
        additionalScopesCheckbox: document.getElementById(
          "additional-scopes-checkbox",
        ),
        additionalScopesInput: document.getElementById(
          "additional-scopes-input",
        ),
        scopeCheckboxes: Array.from(
          document.querySelectorAll("#oauth-scopes-fieldset .scope-checkbox"),
        ),
      };

      const oidc = {
        fieldset: document.getElementById("oidc-fieldset"),
        openidScopeCheckbox: document.getElementById("openid-scope-checkbox"),
        nonceCheckbox: document.getElementById("nonce-checkbox"),
        maxAgeCheckbox: document.getElementById("max-age-checkbox"),
        maxAgeInput: document.getElementById("max-age-input"),
        promptCheckbox: document.getElementById("prompt-checkbox"),
        promptSelect: document.getElementById("prompt-select"),
        displayCheckbox: document.getElementById("display-checkbox"),
        displaySelect: document.getElementById("display-select"),
        uiLocalesCheckbox: document.getElementById("ui-locales-checkbox"),
        uiLocalesSelect: document.getElementById("ui-locales-select"),
        loginHintCheckbox: document.getElementById("login-hint-checkbox"),
        loginHintInput: document.getElementById("login-hint-input"),
        scopeCheckboxes: Array.from(
          document.querySelectorAll("#oidc-scopes-fieldset .scope-checkbox"),
        ),
      };

      const authorizeLink = document.getElementById("authorize-link");
      const resourceRequest = {
        form: document.getElementById("resource-request-form"),
        result: document.getElementById("resource-request-result"),
        submitButton: document.getElementById("resource-request-submit-button"),
        useInvalidAccessTokenCheckbox: document.getElementById(
          "use-invalid-access-token-checkbox",
        ),
        urlInput: document.getElementById("resource-request-url-input"),
      };

      function syncOidcControls() {
        const oidcInputs = oidc.fieldset.querySelectorAll(
          "input, select, textarea, button",
        );
        oidcInputs.forEach((el) => {
          if (el === oidc.openidScopeCheckbox) {
            return;
          }
          el.disabled = !oidc.openidScopeCheckbox.checked;
        });
      }

      function updateAuthorizeLink() {
        const queryParams = new URLSearchParams();

        if (oauth.stateCheckbox.checked) {
          queryParams.set("use_state", "true");
        }
        if (oauth.pkceCheckbox.checked) {
          queryParams.set("use_pkce", "true");
        }
        if (oauth.resourceCheckbox.checked) {
          const resource = oauth.resourceInput.value.trim();
          if (resource) {
            queryParams.set("resource", resource);
          }
        }
        if (oauth.audienceCheckbox.checked) {
          const audience = oauth.audienceInput.value.trim();
          if (audience) {
            queryParams.set("audience", audience);
          }
        }

        const oidcEnabled = oidc.openidScopeCheckbox.checked;
        if (oidcEnabled) {
          if (oidc.nonceCheckbox.checked) {
            queryParams.set("use_nonce", "true");
          }
          if (oidc.maxAgeCheckbox.checked) {
            queryParams.set("max_age", oidc.maxAgeInput.value || "0");
          }
          if (oidc.promptCheckbox.checked) {
            queryParams.set("prompt", oidc.promptSelect.value);
          }
          if (oidc.displayCheckbox.checked) {
            queryParams.set("display", oidc.displaySelect.value);
          }
          if (oidc.uiLocalesCheckbox.checked) {
            queryParams.set("ui_locales", oidc.uiLocalesSelect.value);
          }
          if (oidc.loginHintCheckbox.checked) {
            const loginHint = oidc.loginHintInput.value.trim();
            if (loginHint) {
              queryParams.set("login_hint", loginHint);
            }
          }
        }

        // Scopes
        const scopeCheckboxes = oidcEnabled
          ? [...oauth.scopeCheckboxes, ...oidc.scopeCheckboxes]
          : [...oauth.scopeCheckboxes];
        const selectedScopes = scopeCheckboxes
          .filter((el) => el.checked)
          .map((el) => el.value);
        const additionalScopes = oauth.additionalScopesCheckbox.checked
          ? oauth.additionalScopesInput.value
              .split(/\s+/)
              .map((scope) => scope.trim())
              .filter(Boolean)
          : [];
        const scope = [
          ...new Set([...selectedScopes, ...additionalScopes]),
        ].join(" ");
        if (scope) {
          queryParams.set("scope", scope);
        }

        let href = "/authorize";
        if (queryParams.toString()) {
          href += "?" + queryParams.toString();
        }
        authorizeLink.setAttribute("href", href);
      }

      async function submitResourceRequest(event) {
        event.preventDefault();

        const requestBody = new URLSearchParams();
        requestBody.set("resource_url", resourceRequest.urlInput.value);
        if (resourceRequest.useInvalidAccessTokenCheckbox.checked) {
          requestBody.set("use_invalid_access_token", "true");
        }

        resourceRequest.submitButton.disabled = true;
        resourceRequest.result.textContent = "Loading...";

        try {
          const response = await fetch(resourceRequest.form.action, {
            method: "POST",
            headers: {
              "content-type": "application/x-www-form-urlencoded",
            },
            body: requestBody.toString(),
          });
          const result = await response.json();
          renderResourceRequestResult(result);
        } catch (error) {
          let errorMessage;
          if (error instanceof Error) {
            errorMessage = error.message;
          }

          renderResourceRequestResult({
            ok: false,
            requestUrl: resourceRequest.urlInput.value.trim(),
            errorMessage,
          });
        } finally {
          resourceRequest.submitButton.disabled = false;
        }
      }

      function renderResourceRequestResult(result) {
        resourceRequest.result.replaceChildren();

        const title = document.createElement("h3");
        if (result.ok) {
          title.textContent = "Success";
          title.className = "resource-request-success-title";
        } else {
          title.textContent = "Error";
          title.className = "resource-request-error-title";
        }
        resourceRequest.result.append(title);

        const requestUrl = document.createElement("p");
        requestUrl.append("Request URL: ");
        const requestUrlValue = document.createElement("code");
        requestUrlValue.className = "resource-request-used-url";
        requestUrlValue.textContent = result.requestUrl;
        requestUrl.append(requestUrlValue);
        resourceRequest.result.append(requestUrl);

        if (result.errorMessage) {
          const errorMessage = document.createElement("p");
          errorMessage.textContent = result.errorMessage;
          resourceRequest.result.append(errorMessage);
        }

        const responseBlockLines = [];
        if (result.statusCode !== undefined) {
          let statusLine = `${result.statusCode}`;
          if (result.statusText) {
            statusLine += ` ${result.statusText}`;
          }
          responseBlockLines.push(statusLine);
        }
        if (result.wwwAuthenticate) {
          responseBlockLines.push(
            `WWW-Authenticate: ${result.wwwAuthenticate}`,
          );
        }
        if (result.responseBody) {
          responseBlockLines.push("", result.responseBody);
        }
        if (responseBlockLines.length > 0) {
          const responseBlock = document.createElement("pre");
          responseBlock.textContent = responseBlockLines.join("\n");
          resourceRequest.result.append(responseBlock);
        }
      }

      function addListeners(elements, eventName, listener) {
        elements.forEach((el) => el.addEventListener(eventName, listener));
      }

      function bindOAuthListeners() {
        addListeners(
          [
            ...oauth.scopeCheckboxes,
            oauth.stateCheckbox,
            oauth.pkceCheckbox,
            oauth.resourceCheckbox,
            oauth.audienceCheckbox,
            oauth.additionalScopesCheckbox,
          ],
          "change",
          updateAuthorizeLink,
        );
        addListeners(
          [
            oauth.additionalScopesInput,
            oauth.resourceInput,
            oauth.audienceInput,
          ],
          "input",
          updateAuthorizeLink,
        );
      }

      function bindOidcListeners() {
        const oidcScopeCheckboxes = oidc.scopeCheckboxes.filter(
          (el) => el !== oidc.openidScopeCheckbox,
        );
        addListeners([oidc.openidScopeCheckbox], "change", syncOidcControls);
        addListeners(
          [
            oidc.openidScopeCheckbox,
            ...oidcScopeCheckboxes,
            oidc.nonceCheckbox,
            oidc.maxAgeCheckbox,
            oidc.promptCheckbox,
            oidc.promptSelect,
            oidc.displayCheckbox,
            oidc.displaySelect,
            oidc.uiLocalesCheckbox,
            oidc.uiLocalesSelect,
            oidc.loginHintCheckbox,
          ],
          "change",
          updateAuthorizeLink,
        );
        addListeners(
          [oidc.maxAgeInput, oidc.loginHintInput],
          "input",
          updateAuthorizeLink,
        );
      }

      function bindResourceRequestListener() {
        resourceRequest.form.addEventListener("submit", submitResourceRequest);
      }

      bindOAuthListeners();
      bindOidcListeners();
      bindResourceRequestListener();

      syncOidcControls();
      updateAuthorizeLink();
    </script>
  </body>
</html>

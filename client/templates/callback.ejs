<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Callback</title>
    <style>
      pre {
        max-width: 100%;
        overflow-x: auto;
        box-sizing: border-box;
      }

      table {
        border-collapse: collapse;
      }

      th,
      td {
        padding: 0.25rem 0.5rem 0.25rem 0;
        text-align: left;
        vertical-align: top;
      }

    </style>
  </head>
  <body>
    <h1><%= callbackTitle %></h1>
    <a href="/">Back to home</a>

    <h2>Configuration</h2>
    <table>
      <tbody>
        <tr>
          <th>Client ID</th>
          <td><%= clientId || "No client ID configured." %></td>
        </tr>
        <tr>
          <th>Authorization server URL</th>
          <td>
            <a href="<%= authServerBaseUrl %>"><%= authServerBaseUrl %></a>
          </td>
        </tr>
        <tr>
          <th>Discovery URL</th>
          <td>
            <% if (discoveryUrlUsed) { %>
            <a href="<%= discoveryUrlUsed %>"><%= discoveryUrlUsed %></a>
            <% } else { %>
            No discovery URL used (fallback endpoints configured).
            <% } %>
          </td>
        </tr>
        <tr>
          <th>Authorization endpoint URL</th>
          <td>
            <a href="<%= authorizationEndpointUsed %>"
              ><%= authorizationEndpointUsed %></a
            >
          </td>
        </tr>
        <tr>
          <th>Token endpoint URL</th>
          <td>
            <a href="<%= tokenEndpointUsed %>"><%= tokenEndpointUsed %></a>
          </td>
        </tr>
        <tr>
          <th>JWKS URL</th>
          <td><a href="<%= jwksUrlUsed %>"><%= jwksUrlUsed %></a></td>
        </tr>
      </tbody>
    </table>

    <h2>Response</h2>
    <% if (errorMessage) { %>
    <p><%= errorMessage %></p>
    <% if (tokenResponseJson) { %>
    <h3>Error response body</h3>
    <pre><%= tokenResponseJson %></pre>
    <% } %>

    <% } else { %>
    <% if (tokenResponseJson) { %>
    <h3>Token response</h3>
    <pre><%= tokenResponseJson %></pre>
    <% } %>
    <% if (accessTokenJson) { %>
    <h3>Access token</h3>
    <pre><%= accessTokenJson %></pre>
    <% } else { %>
    <p>No access token present.</p>
    <% } %>
    <% if (idTokenJson) { %>
    <h3>ID token</h3>
    <pre><%= idTokenJson %></pre>
    <% } else { %>
    <p>No ID token present.</p>
    <% } %>
    <% } %>
  </body>
</html>
